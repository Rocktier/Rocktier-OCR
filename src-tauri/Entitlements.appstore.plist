<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rocktier OCR —— Mac App Store 沙箱 entitlements（只写「能力」，不写「身份」）。

  身份三项（application-identifier / team-identifier / keychain-access-groups）
  由 scripts/build-appstore.sh 从描述文件读出后合并注入：codesign 传
  --entitlements 时不会自动从 embedded.provisionprofile 补这三项，缺了它们
  codesign --verify 仍绿、ASC 上传阶段才拒，所以必须显式注入 + 断言。

  与直发轨（Entitlements.plist）的区别：MAS 轨不要 hardened runtime /
  allow-jit，反过来必须开 app-sandbox。两套不能混用。

  出站网络必须开：Tauri 的前端资源走 http://<asset|ipc>.localhost 本地回环，
  沙盒里没有 com.apple.security.network.client 时内核直接拒 socket，Webview
  加载不到 index.html，审核员看到的就是白屏。2026-11-20 的 2.1(a) 拒信
  「app launched to a blank screen」即此因，真机 A/B 已验证（有 key 正常、
  无 key 白屏）。这项能力不等于 OCR 会联网：模型随包分发、推理全在本机，
  业务层没有任何出站请求；loopback 是 Webview 加载自身资源的通道。
-->
<plist version="1.0">
<dict>
    <!-- 沙箱总开关。MAS 强制；缺了这一项 ASC 直接拒。 -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 用户经打开面板/拖放选中的文件可读；识别结果回写原目录需要写。 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Webview 加载自身前端资源所需的 loopback 通道（详见文件头注释）。 -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
