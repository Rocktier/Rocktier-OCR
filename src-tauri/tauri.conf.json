{
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/models",
      "resources/pdfium-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "productName": "Rocktier OCR",
  "version": "0.1.3",
  "identifier": "Rocktier.RocktierOCR",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rocktier OCR",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "mainBinaryName": "RocktierOCR"
}
