node_modules/
dist/
# 运行时资源随仓库分发：模型 15 MB + pdfium 7 MB。少了任何一份，构建出来的
# 应用都跑不起来 —— CI 上没有本机可以借（sync-resources.sh 原来靠隔壁仓库），
# 所以这 22 MB 买的是"在哪都能编出来"。
resources/*
src-tauri/resources/*
!src-tauri/resources/models
!src-tauri/resources/pdfium-runtime
.DS_Store
*.tmp
# 语料不进仓库：扫描件含客户信息，且体积大
corpus/
*.pdf

# 本机测量环境（不进仓库）
.venv-ocr/
corpus/

# OCR 输出缓存（重跑时免去 2.5 分钟识别）
.ocr-cache/
corpus-zh/

# Python 字节码，不该进仓库
__pycache__/
*.pyc

# Rust 构建产物

# Rust 构建产物（任何 crate 的）
target/
